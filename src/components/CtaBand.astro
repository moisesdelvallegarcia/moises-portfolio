---
import Icon from './Icon.astro';
import { SITE, UI, whatsappUrl, type Lang } from '../lib/site';

interface Props { lang: Lang; title: string; text: string; }
const { lang, title, text } = Astro.props;
const t = UI[lang];
---
<section class="container-site mt-24">
  <div class="relative overflow-hidden rounded-[2rem] bg-ink px-6 py-14 text-paper sm:px-12 sm:py-16">
    <svg class="pointer-events-none absolute -right-6 -top-8 h-72 w-72 opacity-15" viewBox="0 0 40 40" aria-hidden="true">
      <g fill="none" stroke="#FAF9F6" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 29.5c-3.2-1.6-4.3-4.4-3-7.2 1.2-2.5 3.6-4.1 4.2-6.7.5-2.2-.6-4.4-2.8-4.9-2-.4-3.7.8-4.1 2.6" /><path d="M14.5 29.5h11.2c3.6 0 6.3-2.6 6.8-6.8-2.6 1.6-5.4 1.4-8.4-.4-2.6-1.6-5-1.2-6.6.9" /></g>
    </svg>
    <p class="font-display text-sm font-semibold uppercase tracking-[0.14em] text-glow">{t.spots(SITE.demo.spots)}</p>
    <h2 class="mt-3 max-w-2xl text-3xl font-bold sm:text-4xl">{title}</h2>
    <p class="mt-4 max-w-xl text-lg text-paper/85">{text}</p>
    <a href={whatsappUrl(lang)} target="_blank" rel="noopener" class="btn btn-primary mt-8">
      <Icon name="whatsapp" />{t.cta}
    </a>
  </div>
</section>

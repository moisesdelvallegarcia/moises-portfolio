---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { NAV, ROUTES, SITE, SLOGAN, UI, whatsappUrl, type Lang } from '../lib/site';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = UI[lang];
const year = new Date().getFullYear();
---
<footer class="mt-24 bg-ink text-paper">
  <div class="container-site grid gap-10 py-14 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <Logo />
      <p class="mt-4 max-w-sm font-display text-xl font-semibold text-glow">{SLOGAN[lang]}</p>
      <p class="mt-2 max-w-sm text-paper/80">{t.footerTag}</p>
    </div>
    <nav aria-label={t.menu}>
      <ul class="space-y-2">
        {NAV.map((key) => <li><a href={ROUTES[key][lang]} class="hover:text-glow">{t.nav[key]}</a></li>)}
        <li><a href={ROUTES.privacy[lang]} class="hover:text-glow">{t.nav.privacy}</a></li>
      </ul>
    </nav>
    <ul class="space-y-3">
      <li><a href={whatsappUrl(lang)} target="_blank" rel="noopener" class="inline-flex items-center gap-2 hover:text-glow"><Icon name="whatsapp" />WhatsApp +52 443 342 8744</a></li>
      {SITE.instagram && (
        <li><a href={SITE.instagram} target="_blank" rel="noopener" class="inline-flex items-center gap-2 hover:text-glow"><Icon name="instagram" />Instagram</a></li>
      )}
      <li><a href={SITE.linkedin} target="_blank" rel="noopener" class="inline-flex items-center gap-2 hover:text-glow"><Icon name="linkedin" />LinkedIn</a></li>
      <li><a href={`mailto:${SITE.email}`} class="inline-flex items-center gap-2 break-all hover:text-glow"><Icon name="mail" />{SITE.email}</a></li>
      <li class="text-paper/70">{SITE.city}, México</li>
    </ul>
  </div>
  <div class="border-t border-paper/15">
    <p class="container-site py-5 text-sm text-paper/70">© {year} {SITE.name}. {t.rights}</p>
  </div>
</footer>

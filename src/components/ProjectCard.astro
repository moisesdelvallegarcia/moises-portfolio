---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { projectPath } from '../lib/content';
import { UI } from '../lib/site';

interface Props { project: CollectionEntry<'projects'>; headingLevel?: 'h2' | 'h3'; }
const { project, headingLevel: H = 'h3' } = Astro.props;
const t = UI[project.data.lang];
---
<article class="group card relative flex flex-col transition-colors hover:border-ink/40">
  <p class="text-sm font-semibold text-rust">{project.data.industry}</p>
  <H class="mt-2 text-2xl font-bold leading-snug">
    <a href={projectPath(project)} class="after:absolute after:inset-0 after:rounded-3xl">{project.data.title}</a>
  </H>
  <p class="mt-3 flex-1 text-muted">{project.data.summary}</p>
  <ul class="mt-5 flex flex-wrap gap-2" aria-label={t.stack}>
    {project.data.stack.slice(0, 4).map((s) => <li class="rounded-full bg-sand px-3 py-1 text-xs font-medium">{s}</li>)}
  </ul>
  <span class="mt-6 inline-flex items-center gap-2 font-display font-semibold" aria-hidden="true">
    {t.readCase}<Icon name="arrow" class="h-4 w-4 transition-transform group-hover:translate-x-1" />
  </span>
</article>

---
// Logo: una "M" dibujada como flujo de automatización (nodos conectados).
interface Props { size?: number; withName?: boolean; }
const { size = 36, withName = true } = Astro.props;
---
<span class="inline-flex items-center gap-2.5">
  <svg width={size} height={size} viewBox="0 0 40 40" aria-hidden="true" class="shrink-0">
    <rect width="40" height="40" rx="10" fill="#0E0F12" />
    <path d="M10 29V12l10 10 10-10v17" fill="none" stroke="#D2382C" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" />
    <g fill="#FAF9F6">
      <circle cx="10" cy="12" r="2.8" /><circle cx="20" cy="22" r="2.8" /><circle cx="30" cy="12" r="2.8" />
      <circle cx="10" cy="29" r="2.8" /><circle cx="30" cy="29" r="2.8" />
    </g>
  </svg>
  {withName && (
    <span class="font-display text-lg font-bold leading-none tracking-tight">
      Moisés Del Valle<span class="hidden sm:inline"> García</span>
    </span>
  )}
</span>

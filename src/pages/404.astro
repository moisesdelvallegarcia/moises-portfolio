---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { ROUTES } from '../lib/site';
---
<Base lang="es" title="Página no encontrada" description="Esta página no existe." alternates={{}} noindex>
  <section class="container-site max-w-3xl py-24 sm:py-32">
    <p class="eyebrow">Error 404</p>
    <h1 class="mt-3 text-4xl font-extrabold sm:text-6xl">Esta página no existe</h1>
    <p class="mt-5 text-lg text-muted">Puede que el enlace esté mal escrito o que la página se haya movido.</p>
    <p class="mt-2 text-lg text-muted" lang="en">This page doesn’t exist. It may have moved, or the link may be mistyped.</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href={ROUTES.home.es} class="btn btn-primary">Ir al inicio</a>
      <a href={ROUTES.home.en} class="btn btn-ghost" lang="en">Go to the English site<Icon name="arrow" class="h-4 w-4" /></a>
    </div>
  </section>
</Base>

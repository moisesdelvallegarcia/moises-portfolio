---
// Catálogo de MacBooks reacondicionadas que Moisés vende en Morelia. Las Macs y los precios
// (los de Mercado Libre) se leen en vivo del sistema de inventario de Nonatech, así que esta
// página no hay que tocarla cuando llega o se vende una Mac.
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import { SITE, whatsappUrl } from '../lib/site';

const catalogoUrl = `${import.meta.env.DEV ? 'http://localhost:3000' : 'https://nonatech.mx'}/api/v/moises/catalogo`;
const preguntaUrl = whatsappUrl('es', 'Hola Moisés, vi tus MacBooks en tu página y tengo una pregunta.');
---
<Base
  lang="es"
  title="MacBooks reacondicionadas en Morelia"
  description="MacBook Air y Pro revisadas por técnico y con batería medida. Te la entrego en bici en Morelia, 100% ecológico. Pregunta por WhatsApp."
  alternates={{ es: '/macs/' }}
>
  <PageHeader
    eyebrow="MacBooks en Morelia"
    title="MacBooks reacondicionadas, entregadas en tu mano"
    intro="Revisadas una por una por técnico y con la batería medida. Eliges la tuya, me escribes por WhatsApp y te la llevo en bici a cualquier punto de Morelia para que la pruebes antes de pagar. 100% ecológico."
  >
    <ul class="mt-8 flex flex-wrap gap-2 text-sm font-semibold">
      <li class="flex items-center gap-2 rounded-full bg-sand px-4 py-2"><Icon name="check" class="h-4 w-4 text-leaf" />Entrega en bici en Morelia 🚲</li>
      <li class="flex items-center gap-2 rounded-full bg-sand px-4 py-2"><Icon name="check" class="h-4 w-4 text-leaf" />Revisadas por técnico</li>
      <li class="flex items-center gap-2 rounded-full bg-sand px-4 py-2"><Icon name="check" class="h-4 w-4 text-leaf" />Batería medida</li>
    </ul>
  </PageHeader>

  <section class="container-site mt-12" aria-labelledby="disponibles">
    <h2 id="disponibles" class="text-3xl font-bold">Disponibles hoy</h2>
    <p id="estado" class="mt-3 text-lg text-muted" aria-live="polite">Cargando las Macs disponibles…</p>
    <ul id="lista" class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3" data-catalogo={catalogoUrl}></ul>
    <a id="sin-datos" href={preguntaUrl} target="_blank" rel="noopener" class="btn btn-whatsapp mt-6" hidden><Icon name="whatsapp" />Pregúntame por WhatsApp</a>
  </section>

  <template id="tarjeta">
    <li class="card flex flex-col !p-0 overflow-hidden">
      <div class="relative aspect-[4/3] shrink-0 overflow-hidden bg-sand">
        <img data-foto alt="" loading="lazy" class="absolute inset-0 h-full w-full object-cover" hidden />
        <div data-sin-foto class="flex h-full items-center justify-center text-silver">
          <svg viewBox="0 0 64 40" class="w-1/2" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="10" y="3" width="44" height="28" rx="2" /><path d="M3 34h58l-3 3H6Z" /></svg>
        </div>
      </div>
      <div class="flex flex-1 flex-col p-6">
        <h3 data-modelo class="text-xl font-bold"></h3>
        <p data-specs class="mt-1 text-muted"></p>
        <p data-detalle class="mt-1 text-sm text-muted"></p>
        <p class="mt-4 font-display text-3xl font-extrabold"><span data-precio></span> <span class="text-base font-semibold text-muted">MXN</span></p>
        <a data-whatsapp target="_blank" rel="noopener" class="btn btn-whatsapp mt-5 self-start"><Icon name="whatsapp" />La quiero</a>
      </div>
    </li>
  </template>

  <section class="container-site mt-20 max-w-3xl">
    <div class="rounded-3xl bg-sand p-6 sm:p-8">
      <h2 class="text-2xl font-bold">¿Cómo es la entrega?</h2>
      <p class="mt-3 text-lg text-muted">Me escribes, quedamos en un punto de {SITE.city} y te la llevo en bici 🚲, 100% ecológico. La revisas ahí mismo: que prenda, la batería, la pantalla y el teclado. Si te convence, me pagas en ese momento.</p>
      <a href={preguntaUrl} target="_blank" rel="noopener" class="btn btn-whatsapp mt-6"><Icon name="whatsapp" />Escríbeme por WhatsApp</a>
    </div>
  </section>
</Base>

<script>
  import { whatsappUrl } from '../lib/site';

  type Producto = {
    slug: string;
    fotoUrl: string | null;
    modeloNombre: string;
    anio: number | null;
    procesador: string;
    ramGb: number;
    almacenamientoGb: number;
    disponibles: number;
    grados: string[];
    precioCentavos: number;
  };

  const GRADOS: Record<string, string> = { excelente: 'como nueva', bueno: 'buen estado', malo: 'con detalles estéticos' };
  const pesos = new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN', maximumFractionDigits: 0 });
  const disco = (gb: number) => (gb >= 1000 ? `${Math.round(gb / 1000)} TB` : `${gb} GB`);

  const lista = document.getElementById('lista')!;
  const estado = document.getElementById('estado')!;
  const sinDatos = document.getElementById('sin-datos')!;
  const tarjeta = document.getElementById('tarjeta') as HTMLTemplateElement;

  function pintar(productos: Producto[]) {
    if (productos.length === 0) {
      estado.textContent = 'Por ahora no tengo Macs disponibles. Escríbeme y te aviso cuando lleguen.';
      sinDatos.hidden = false;
      return;
    }
    estado.textContent = `${productos.length} ${productos.length === 1 ? 'configuración' : 'configuraciones'} disponibles. El precio es por equipo.`;
    for (const p of productos) {
      const li = tarjeta.content.firstElementChild!.cloneNode(true) as HTMLElement;
      const q = <T extends HTMLElement>(sel: string) => li.querySelector<T>(sel)!;
      if (p.fotoUrl) {
        const img = q<HTMLImageElement>('[data-foto]');
        img.src = p.fotoUrl;
        img.alt = p.modeloNombre;
        img.hidden = false;
        q('[data-sin-foto]').hidden = true;
      }
      const specs = `${p.procesador} · ${p.ramGb} GB de RAM · ${disco(p.almacenamientoGb)}`;
      const estados = p.grados.map((g) => GRADOS[g]).filter(Boolean).join(' o ');
      q('[data-modelo]').textContent = p.modeloNombre;
      q('[data-specs]').textContent = specs;
      q('[data-detalle]').textContent = [estados && `En ${estados}`, p.disponibles === 1 ? 'Queda 1' : `Quedan ${p.disponibles}`].filter(Boolean).join(' · ');
      q('[data-precio]').textContent = pesos.format(p.precioCentavos / 100);
      q<HTMLAnchorElement>('[data-whatsapp]').href = whatsappUrl(
        'es',
        `Hola Moisés, me interesa la ${p.modeloNombre} (${specs}) de ${pesos.format(p.precioCentavos / 100)}. ¿Me la puedes entregar en Morelia?`,
      );
      lista.append(li);
    }
  }

  fetch(lista.dataset.catalogo!)
    .then((r) => (r.ok ? r.json() : Promise.reject(r.status)))
    .then((d: { productos: Producto[] }) => pintar(d.productos))
    .catch(() => {
      estado.textContent = 'No pude cargar la lista en este momento. Escríbeme y te paso las Macs que tengo.';
      sinDatos.hidden = false;
    });
</script>

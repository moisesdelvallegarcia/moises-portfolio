---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Pendiente from '../components/Pendiente.astro';
import CtaBand from '../components/CtaBand.astro';
import photo from '../assets/moises.jpg';
import { personJsonLd } from '../lib/content';
import { ROUTES, SITE, type Lang } from '../lib/site';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const copy = {
  es: {
    title: 'Sobre mí',
    description: 'Soy Moisés Del Valle García, ingeniero en sistemas de Morelia. Pasé años probando software para empresas grandes y hoy construyo automatizaciones con IA para negocios.',
    eyebrow: 'Sobre mí',
    h1: 'Hola, soy Moisés',
    draft: 'BORRADOR: Moisés revisa y ajusta esta historia',
    photo: 'FOTO: confirmar esta o cambiarla por una profesional',
    story: [
      'Soy ingeniero en sistemas y vivo en Morelia, Michoacán. Durante años mi trabajo fue probar software de empresas grandes antes de que llegara a sus clientes: aplicaciones web y móviles, validaciones en bases de datos y despliegues a producción. Mi trabajo era encontrar dónde fallan las cosas.',
      'Ahí aprendí algo que hoy uso todos los días: casi todos los errores vienen de pasos que alguien hace a mano. Copiar un dato de un sistema a otro, revisar una lista, acordarse de avisar. No es falta de ganas; es que las personas no deberían estar haciendo el trabajo de una máquina.',
      'Hoy construyo sistemas automatizados con inteligencia artificial para negocios. El más grande conecta casi toda la operación de una constructora en Estados Unidos: lee sus facturas, cruza entregas contra trabajos y cada mañana le dice al equipo qué hay pendiente.',
      'Mi forma de trabajar es sencilla: empiezo por la tarea que más tiempo te quita, uso las herramientas que ya tienes y pruebo todo antes de que lo uses. Si lo puedes imaginar, lo programamos.',
    ],
    experienceTitle: 'Experiencia',
    experience: [
      ['Automatización con IA para negocios', 'Independiente', 'Hoy'],
      ['QA Engineer · GET (GeTechnologies)', 'Pruebas UAT, validaciones SQL y despliegues a producción para una cadena de farmacias', '2024 – 2025'],
      ['QA Test Engineer · SCIO', 'Pruebas en web, Android e iOS para una plataforma educativa de EE. UU.', '2021 – 2023'],
      ['Presidente · Rotaract Morelia Camelinas Centenario', 'Liderazgo de equipo y organización de proyectos', '2024 – 2025'],
    ],
    cv: 'Descargar CV (PDF)',
    ctaTitle: '¿Platicamos de tu negocio?',
    ctaText: 'Cuéntame qué te quita más tiempo y vemos si se puede automatizar.',
  },
  en: {
    title: 'About me',
    description: 'I’m Moisés Del Valle García, a systems engineer from Morelia, Mexico. I spent years testing software for large companies and now build AI automation for businesses.',
    eyebrow: 'About',
    h1: 'Hi, I’m Moisés',
    draft: 'DRAFT: Moisés to review and adjust this story',
    photo: 'PHOTO: keep this one or replace it with a professional one',
    story: [
      'I’m a systems engineer based in Morelia, Mexico. For years my job was testing software for large companies before it reached their customers: web and mobile apps, database validations and production releases. I got paid to find where things break.',
      'That taught me something I use every day: most errors come from steps someone does by hand. Copying data from one system to another, checking a list, remembering to tell someone. It’s not a lack of effort — people just shouldn’t be doing a machine’s job.',
      'Today I build AI-powered automated systems for businesses. The largest one runs most of the back office for a concrete contractor in Iowa: it reads their invoices, matches deliveries to jobs and tells the team every morning what needs attention.',
      'The way I work is simple: start with the task that costs you the most time, use the tools you already have, and test everything before you rely on it. If you can imagine it, we can build it.',
    ],
    experienceTitle: 'Experience',
    experience: [
      ['AI automation for businesses', 'Independent', 'Present'],
      ['QA Engineer · GET (GeTechnologies)', 'UAT testing, SQL validation and production releases for a pharmacy chain', '2024 – 2025'],
      ['QA Test Engineer · SCIO', 'Web, Android and iOS testing for a US education platform', '2021 – 2023'],
      ['President · Rotaract Morelia Camelinas Centenario', 'Team leadership and project organization', '2024 – 2025'],
    ],
    cv: 'Download CV (PDF)',
    ctaTitle: 'Want to talk about your business?',
    ctaText: 'Tell me what eats up your time and we’ll see if it can be automated.',
  },
}[lang];
---
<Base lang={lang} title={copy.title} description={copy.description} alternates={ROUTES.about} current="about" ogImage={`about-${lang}`} jsonLd={[personJsonLd(lang)]}>
  <section class="container-site grid gap-12 pt-14 sm:pt-20 md:grid-cols-[minmax(0,380px)_1fr]">
    <div>
      <Image src={photo} alt={lang === 'es' ? 'Foto de Moisés Del Valle García' : 'Photo of Moisés Del Valle García'}
        widths={[380, 760]} sizes="(min-width: 768px) 380px, 100vw" loading="eager"
        class="aspect-square w-full rounded-[2rem] object-cover" />
      <p class="mt-3"><Pendiente label={copy.photo} /></p>
    </div>
    <div>
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1 class="mt-3 text-4xl font-extrabold sm:text-6xl">{copy.h1}</h1>
      <p class="mt-4"><Pendiente label={copy.draft} /></p>
      <div class="prose-site mt-6">
        {copy.story.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  <section class="container-site mt-20 max-w-4xl" aria-labelledby="exp">
    <h2 id="exp" class="text-3xl font-bold sm:text-4xl">{copy.experienceTitle}</h2>
    <ol class="mt-8 divide-y divide-line border-y border-line">
      {copy.experience.map(([role, detail, years]) => (
        <li class="grid gap-1 py-5 sm:grid-cols-[1fr_auto] sm:gap-6">
          <div>
            <h3 class="text-xl font-bold">{role}</h3>
            <p class="mt-1 text-muted">{detail}</p>
          </div>
          <p class="font-display font-semibold text-rust">{years}</p>
        </li>
      ))}
    </ol>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/moises-del-valle-garcia-cv.pdf" class="btn btn-ghost">{copy.cv}</a>
      <a href={SITE.linkedin} target="_blank" rel="noopener" class="btn btn-ghost"><Icon name="linkedin" />LinkedIn</a>
    </div>
  </section>

  <CtaBand lang={lang} title={copy.ctaTitle} text={copy.ctaText} />
</Base>
